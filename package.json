{
  "name": "kosem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/validation.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-kosem --only firestore,storage 'node --test tests/rules.test.mjs'",
    "test:browser": "node tests/browser.mjs",
    "test:integration": "firebase emulators:exec --project demo-kosem --only auth,firestore,storage 'node --test tests/rules.test.mjs && node tests/emulator-browser.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.56.0"
  }
}

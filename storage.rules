rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function own(uid) { return request.auth != null && request.auth.uid == uid; }
  function imageValid() {
   return request.resource.size <= 2 * 1024 * 1024 && request.resource.size > 0
    && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
  }
  match /avatars/{uid}/{filename} {
   allow read: if true;
   allow create, update: if own(uid) && imageValid();
   allow delete: if own(uid);
  }
  match /covers/{uid}/{filename} {
   allow read: if true;
   allow create, update: if own(uid) && imageValid();
   allow delete: if own(uid);
  }
 }
}
